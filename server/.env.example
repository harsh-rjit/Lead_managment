PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster address with your Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_business_ops?retryWrites=true&w=majority

# JWT Authentication Secrets
# Generate a strong 64-character random string for production
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d
